+const isSelfRepeatingStarBranch = branch => {
+  let escaped = false;
+  let bracket = false;
+  let star = false;
+
+  for (let i = 0; i < branch.length; i++) {
+    const ch = branch[i];
+
+    if (escaped === true) {
+      escaped = false;
+      continue;
+    }
+
+    if (ch === '\\') {
+      escaped = true;
+      continue;
+    }
+
+    if (bracket === true) {
+      if (ch === ']') bracket = false;
+      continue;
+    }
+
+    if (ch === '[') {
+      bracket = true;
+      continue;
+    }
+
+    if (/[/(){}|!+@]/.test(ch)) {
+      return false;
+    }
+
+    if (ch === '*') {
+      if (branch[i + 1] === '*') {
+        return false;
+      }
+      star = true;
+    }
+  }
+
+  return star && !escaped && !bracket;
+};
+
