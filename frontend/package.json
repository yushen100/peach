{
  "name": "peach-frontend",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "allowScripts": {
    "@sentry/cli": false,
    "fsevents": false
  },
  "scripts": {
    "dev": "vite build --watch",
    "build": "vite build && vite build -c vite.pages.config.ts",
    "sentry:upload": "node scripts/upload-sourcemaps.ts",
    "build:agentation": "vite build -c vite.agentation.config.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p src/react",
    "lint": "oxlint -c .oxlintrc.json src test e2e",
    "check:copy": "node scripts/copy-check.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "node --test --test-concurrency=1 --test-reporter=tap \"e2e/**/*.test.ts\"",
    "i18n:literals": "node scripts/i18n-literals.ts",
    "i18n:terms": "node scripts/i18n-terms.ts"
  },
  "dependencies": {
    "@remixicon/react": "4.9.0",
    "@tanstack/query-core": "5.108.0",
    "@tanstack/react-query": "5.108.0",
    "@tanstack/react-table": "9.3.1",
    "clsx": "2.1.1",
    "d3-sankey": "0.12.3",
    "diff": "9.0.0",
    "driver.js": "1.14.0",
    "i18next": "27.1.5",
    "motion": "14.14.0",
    "react": "19.3.1",
    "react-aria": "3.53.1",
    "react-aria-components": "1.22.1",
    "react-dom": "19.3.1",
    "react-router": "8.5.1",
    "recharts": "3.11.0",
    "skullet": "0.0.3",
    "sonner": "2.0.8",
    "tailwind-merge": "3.7.0"
  },
  "devDependencies": {
    "@sentry/cli": "3.8.2",
    "@sentry/vite-plugin": "11.14.0",
    "@shadcn/lint": "0.2.5",
    "@tailwindcss/vite": "4.3.5",
    "@types/d3-sankey": "0.12.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "agentation": "3.1.2",
    "happy-dom": "21.0.4",
    "oxc-parser": "0.159.0",
    "oxlint": "1.94.0",
    "picomatch": "file:vendor/picomatch-4.0.7-peach-pr237.tgz",
    "playwright-core": "1.65.1",
    "tailwindcss": "4.3.5",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  },
  "overrides": {
    "@sentry/bundler-plugins": {
      "glob": "14.0.3"
    }
  }
}
